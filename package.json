
{
  "name": "veyra",
  "productName": "VEYRA",
  "version": "2.0.0",
  "description": "Smart Assessments. Seamless Execution. — A desktop examination, quiz, and proctoring platform.",
  "main": "app/app.js",
  "type": "module",
  "scripts": {
    "start": "vite build && electron ./app/app.js",
    "dev": "vite",
    "dev:backend": "node backend/server.js",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev\"",
    "all": "npm run dev:all",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "vite build && electron ./app/app.js",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron ./app/app.js --dev\"",
    "test": "node backend/tests/run-tests.js",
    "dist": "vite build && electron-builder",
    "dist:mac": "vite build && electron-builder --mac dmg --arm64",
    "dist:mac:universal": "vite build && electron-builder --mac dmg --universal"
  },
  "build": {
    "appId": "com.veyra.examplatform",
    "productName": "VEYRA",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "app/**/*",
      "package.json"
    ],
    
"extraResources": [
  {
    "from": "backend",
    "to": "backend",
    "filter": [
      "**/*",
      "!node_modules/**"
    ]
  },
  {
    "from": "backend/node_modules",
    "to": "backend/node_modules",
    "filter": [
      "**/*"
    ]
  }
]
,
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "dmg": {
      "title": "VEYRA Installer",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  }
}
